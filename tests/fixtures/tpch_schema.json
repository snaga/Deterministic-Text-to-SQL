{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TPC-H Schema Metadata for Jev Classification",
  "description": "TPC-H ベンチマーク 8 テーブルのスキーマ定義および Jev 判別用セマンティックメタデータ",
  "tables": [
    {
      "name": "region",
      "description": "地域・大陸情報（AFRICA, AMERICA, ASIA, EUROPE, MIDDLE EAST）",
      "aliases": ["地域", "エリア", "大陸", "リージョン", "region"],
      "primary_key": ["r_regionkey"],
      "foreign_keys": [],
      "columns": [
        {"name": "r_regionkey", "type": "INTEGER", "description": "地域ID（主キー）", "role": "id"},
        {"name": "r_name", "type": "CHAR(25)", "description": "地域名（例: ASIA, EUROPE）", "role": "dimension", "values": ["AFRICA", "AMERICA", "ASIA", "EUROPE", "MIDDLE EAST"]},
        {"name": "r_comment", "type": "VARCHAR(152)", "description": "備考", "role": "attribute"}
      ]
    },
    {
      "name": "nation",
      "description": "国情報（日本、アメリカ、中国、ドイツ等25カ国）",
      "aliases": ["国", "国家", "国名", "ネイション", "nation", "country"],
      "primary_key": ["n_nationkey"],
      "foreign_keys": [
        {"column": "n_regionkey", "ref_table": "region", "ref_column": "r_regionkey"}
      ],
      "columns": [
        {"name": "n_nationkey", "type": "INTEGER", "description": "国ID（主キー）", "role": "id"},
        {"name": "n_name", "type": "CHAR(25)", "description": "国名（例: JAPAN, UNITED STATES）", "role": "dimension"},
        {"name": "n_regionkey", "type": "INTEGER", "description": "所属地域ID（外部キー: region.r_regionkey）", "role": "fk"},
        {"name": "n_comment", "type": "VARCHAR(152)", "description": "備考", "role": "attribute"}
      ]
    },
    {
      "name": "supplier",
      "description": "仕入先・部品サプライヤー情報",
      "aliases": ["仕入先", "サプライヤー", "供給業者", "仕入業者", "supplier", "vendor"],
      "primary_key": ["s_suppkey"],
      "foreign_keys": [
        {"column": "s_nationkey", "ref_table": "nation", "ref_column": "n_nationkey"}
      ],
      "columns": [
        {"name": "s_suppkey", "type": "INTEGER", "description": "仕入先ID（主キー）", "role": "id"},
        {"name": "s_name", "type": "CHAR(25)", "description": "仕入先名", "role": "dimension"},
        {"name": "s_address", "type": "VARCHAR(40)", "description": "住所", "role": "attribute"},
        {"name": "s_nationkey", "type": "INTEGER", "description": "所在国ID（外部キー: nation.n_nationkey）", "role": "fk"},
        {"name": "s_phone", "type": "CHAR(15)", "description": "電話番号", "role": "attribute"},
        {"name": "s_acctbal", "type": "DECIMAL(15,2)", "description": "口座残高・未払残高", "role": "metric", "agg": ["SUM", "AVG", "MIN", "MAX"]},
        {"name": "s_comment", "type": "VARCHAR(101)", "description": "備考", "role": "attribute"}
      ]
    },
    {
      "name": "customer",
      "description": "顧客・会員情報（セグメント、口座残高、国籍など）",
      "aliases": ["顧客", "カスタマー", "会員", "ユーザー", "取引先", "customer", "client"],
      "primary_key": ["c_custkey"],
      "foreign_keys": [
        {"column": "c_nationkey", "ref_table": "nation", "ref_column": "n_nationkey"}
      ],
      "columns": [
        {"name": "c_custkey", "type": "BIGINT", "description": "顧客ID（主キー）", "role": "id"},
        {"name": "c_name", "type": "VARCHAR(25)", "description": "顧客名", "role": "dimension"},
        {"name": "c_address", "type": "VARCHAR(40)", "description": "住所", "role": "attribute"},
        {"name": "c_nationkey", "type": "INTEGER", "description": "所在国ID（外部キー: nation.n_nationkey）", "role": "fk"},
        {"name": "c_phone", "type": "CHAR(15)", "description": "電話番号", "role": "attribute"},
        {"name": "c_acctbal", "type": "DOUBLE PRECISION", "description": "口座残高", "role": "metric", "agg": ["SUM", "AVG", "MIN", "MAX"]},
        {"name": "c_mktsegment", "type": "CHAR(10)", "description": "市場セグメント（AUTOMOBILE, BUILDING, FURNITURE, MACHINERY, HOUSEHOLD）", "role": "dimension", "values": ["AUTOMOBILE", "BUILDING", "FURNITURE", "MACHINERY", "HOUSEHOLD"]},
        {"name": "c_comment", "type": "VARCHAR(117)", "description": "備考", "role": "attribute"}
      ]
    },
    {
      "name": "part",
      "description": "部品・製品カタログ情報（名称、ブランド、メーカー、容器、小売価格）",
      "aliases": ["部品", "商品", "パーツ", "製品", "カタログ", "アイテム", "part", "item", "product"],
      "primary_key": ["p_partkey"],
      "foreign_keys": [],
      "columns": [
        {"name": "p_partkey", "type": "INTEGER", "description": "部品ID（主キー）", "role": "id"},
        {"name": "p_name", "type": "VARCHAR(55)", "description": "部品名", "role": "dimension"},
        {"name": "p_mfgr", "type": "CHAR(25)", "description": "製造メーカー", "role": "dimension"},
        {"name": "p_brand", "type": "CHAR(10)", "description": "ブランド", "role": "dimension"},
        {"name": "p_type", "type": "VARCHAR(25)", "description": "部品種別（例: PROMO BRUSHED BRASS, LARGE POLISHED COPPER）", "role": "dimension"},
        {"name": "p_size", "type": "INTEGER", "description": "サイズ", "role": "dimension"},
        {"name": "p_container", "type": "CHAR(10)", "description": "梱包容器（例: SM CASE, JUMBO BOX）", "role": "dimension"},
        {"name": "p_retailprice", "type": "DECIMAL(15,2)", "description": "小売定価", "role": "metric", "agg": ["AVG", "MIN", "MAX"]},
        {"name": "p_comment", "type": "VARCHAR(23)", "description": "備考", "role": "attribute"}
      ]
    },
    {
      "name": "partsupp",
      "description": "部品×サプライヤー供給情報（在庫数、供給・仕入原価）",
      "aliases": ["在庫", "部品供給", "仕入原価", "供給情報", "部品在庫", "partsupp", "inventory"],
      "primary_key": ["ps_partkey", "ps_suppkey"],
      "foreign_keys": [
        {"column": "ps_partkey", "ref_table": "part", "ref_column": "p_partkey"},
        {"column": "ps_suppkey", "ref_table": "supplier", "ref_column": "s_suppkey"}
      ],
      "columns": [
        {"name": "ps_partkey", "type": "BIGINT", "description": "部品ID（複合主キー / 外部キー: part.p_partkey）", "role": "fk"},
        {"name": "ps_suppkey", "type": "BIGINT", "description": "仕入先ID（複合主キー / 外部キー: supplier.s_suppkey）", "role": "fk"},
        {"name": "ps_availqty", "type": "BIGINT", "description": "利用可能在庫数量", "role": "metric", "agg": ["SUM", "AVG", "MIN", "MAX"]},
        {"name": "ps_supplycost", "type": "DOUBLE PRECISION", "description": "仕入原価・調達コスト", "role": "metric", "agg": ["SUM", "AVG", "MIN", "MAX"]},
        {"name": "ps_comment", "type": "VARCHAR(199)", "description": "備考", "role": "attribute"}
      ]
    },
    {
      "name": "orders",
      "description": "注文伝票ヘッダー情報（注文日、注文ステータス、合計請求額、優先度）",
      "aliases": ["注文", "オーダー", "受注", "注文ヘッダー", "orders", "sales_order"],
      "primary_key": ["o_orderkey"],
      "foreign_keys": [
        {"column": "o_custkey", "ref_table": "customer", "ref_column": "c_custkey"}
      ],
      "columns": [
        {"name": "o_orderkey", "type": "BIGINT", "description": "注文ID（主キー）", "role": "id"},
        {"name": "o_custkey", "type": "BIGINT", "description": "注文した顧客ID（外部キー: customer.c_custkey）", "role": "fk"},
        {"name": "o_orderstatus", "type": "CHAR(1)", "description": "注文ステータス（O: 未完了/Open, F: 完了/Fulfilled, P: 保留/Pending）", "role": "dimension", "values": ["O", "F", "P"]},
        {"name": "o_totalprice", "type": "DOUBLE PRECISION", "description": "注文合計金額", "role": "metric", "agg": ["SUM", "AVG", "MIN", "MAX"]},
        {"name": "o_orderdate", "type": "DATE", "description": "注文日", "role": "date_filter"},
        {"name": "o_orderpriority", "type": "CHAR(15)", "description": "注文優先度（1-URGENT, 2-HIGH, 3-MEDIUM, 4-NOT SPECIFIED, 5-LOW）", "role": "dimension"},
        {"name": "o_clerk", "type": "CHAR(15)", "description": "担当事務員", "role": "attribute"},
        {"name": "o_shippriority", "type": "INTEGER", "description": "出荷優先順位", "role": "dimension"},
        {"name": "o_comment", "type": "VARCHAR(79)", "description": "備考", "role": "attribute"}
      ]
    },
    {
      "name": "lineitem",
      "description": "注文明細情報（商品ごとの数量、売上金額、値引率、税率、返品フラグ、配送日、配送モード）",
      "aliases": ["明細", "注文明細", "売上明細", "ラインアイテム", "購入明細", "lineitem", "order_detail"],
      "primary_key": ["l_orderkey", "l_linenumber"],
      "foreign_keys": [
        {"column": "l_orderkey", "ref_table": "orders", "ref_column": "o_orderkey"},
        {"column": "l_partkey", "ref_table": "part", "ref_column": "p_partkey"},
        {"column": "l_suppkey", "ref_table": "supplier", "ref_column": "s_suppkey"},
        {"column": ["l_partkey", "l_suppkey"], "ref_table": "partsupp", "ref_column": ["ps_partkey", "ps_suppkey"]}
      ],
      "columns": [
        {"name": "l_orderkey", "type": "BIGINT", "description": "注文ID（複合主キー / 外部キー: orders.o_orderkey）", "role": "fk"},
        {"name": "l_partkey", "type": "BIGINT", "description": "部品ID（外部キー: part.p_partkey）", "role": "fk"},
        {"name": "l_suppkey", "type": "BIGINT", "description": "仕入先ID（外部キー: supplier.s_suppkey）", "role": "fk"},
        {"name": "l_linenumber", "type": "BIGINT", "description": "注文内明細番号（複合主キー）", "role": "id"},
        {"name": "l_quantity", "type": "DOUBLE PRECISION", "description": "購入数量", "role": "metric", "agg": ["SUM", "AVG", "MIN", "MAX"]},
        {"name": "l_extendedprice", "type": "DOUBLE PRECISION", "description": "定価売上額（quantity * retailprice）", "role": "metric", "agg": ["SUM", "AVG", "MIN", "MAX"]},
        {"name": "l_discount", "type": "DOUBLE PRECISION", "description": "値引率（0.00 〜 0.10）", "role": "metric", "agg": ["AVG", "MIN", "MAX"]},
        {"name": "l_tax", "type": "DOUBLE PRECISION", "description": "税率（0.00 〜 0.08）", "role": "metric", "agg": ["AVG"]},
        {"name": "l_returnflag", "type": "CHAR(1)", "description": "返品フラグ（R: 返品済み/Returned, A: 返品承認済み/Approved, N: 正常/Normal）", "role": "filter", "values": ["R", "A", "N"]},
        {"name": "l_linestatus", "type": "CHAR(1)", "description": "明細ステータス（O: 出荷前/Open, F: 出荷済・請求済/Fulfilled）", "role": "filter", "values": ["O", "F"]},
        {"name": "l_shipdate", "type": "DATE", "description": "出荷日", "role": "date_filter"},
        {"name": "l_commitdate", "type": "DATE", "description": "確約納期", "role": "date_filter"},
        {"name": "l_receiptdate", "type": "DATE", "description": "受領受取日", "role": "date_filter"},
        {"name": "l_shipinstruct", "type": "CHAR(25)", "description": "配送指示（DELIVER IN PERSON, TAKE BACK RETURN 等）", "role": "dimension"},
        {"name": "l_shipmode", "type": "CHAR(10)", "description": "配送手段（AIR, REG AIR, SHIP, TRUCK, MAIL, FOB, RAIL）", "role": "dimension", "values": ["AIR", "REG AIR", "SHIP", "TRUCK", "MAIL", "FOB", "RAIL"]},
        {"name": "l_comment", "type": "VARCHAR(44)", "description": "明細備考", "role": "attribute"}
      ]
    }
  ]
}
